<div>
  <div>
    <h1><%= @collection.title %></h1>

    <% if @collection.description.present? %>
      <p><%= @collection.description %></p>
    <% end %>

    <p class="collection-info">Тип: <%= @collection.collection_type %></p>
  </div>

  <div class="collection-actions">
    <%= link_to "изменить", edit_collection_path(@collection) %>
    <%= button_to "удалить", collection_path(@collection), method: :delete, data: { turbo_confirm: "удалить коллекцию?" } %>
  </div>
</div>

<hr>

<h2>Игры в коллекции</h2>

<% if @collection.collection_games.any? %>
  <div class="games-all">
    <% @collection.collection_games.each do |collection_game| %>
      <article class="game-card">
        <div class="game-card-content">
          <h3><%= link_to collection_game.game.title, game_path(collection_game.game) %></h3>
          <p class="game-info"><%= collection_game.game.genres.map(&:name).join(", ") %></p>

          <%= button_to "убрать из коллекции", collection_game_path(collection_game), method: :delete %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p>В этой коллекции пока нет игр</p>
<% end %>

<p class="back-link"><%= link_to "обратно к коллекциям", collections_path %></p>